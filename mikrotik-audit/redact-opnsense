#!/usr/bin/env python3
"""redact-opnsense: normalize an OPNsense config.xml for diffing (stdin -> stdout).

Drops the per-save <revision> block and lastchange stamps, and replaces the values of secret-bearing
tags with a short hash, so a diff still shows THAT a secret changed without showing the secret.
Used by mikrotik-audit/run.sh before the diff goes to the model.
"""
import hashlib
import re
import sys

s = sys.stdin.read()
s = re.sub(r"<revision>.*?</revision>", "<revision/>", s, flags=re.S)
s = re.sub(r"<(lastchange|last_change)>.*?</\1>", r"<\1/>", s, flags=re.S)
SECRET = (r"password|passwd|bcrypt-hash|sha512-hash|apikeys?|secret|key|prv|privkey|private_?key|"
          r"pre-shared-key|psk|presharedkey|authorizedkeys|otp_seed|community|token|ldap_bindpw")


def hide(m):
    val = m.group(2)
    if not val.strip():
        return m.group(0)
    h = hashlib.sha256(val.encode()).hexdigest()[:8]
    return f"<{m.group(1)}>[REDACTED:{h}]</{m.group(1)}>"


s = re.sub(r"<(" + SECRET + r")>(.*?)</\1>", hide, s, flags=re.S | re.I)
sys.stdout.write(s)
